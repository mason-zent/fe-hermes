{
  "$comment": "헤르메스가 담당하는 레포 목록. 경로는 reposRoot 기준이며 scripts/setup.sh 가 repos/<name> 링크를 만든다. branch = 문서·지식의 기준(운영 반영분). bznav-web 은 앱마다 prd 브랜치가 따로 있어 apps 안에서 지정한다.",
  "reposRoot": "..",
  "repos": [
    { "name": "client-brics-refund", "agents": ["refund-fe"], "branch": "prd", "kind": "single", "appDir": "app" },
    { "name": "client-brics-hub",    "agents": ["hub-fe"],    "branch": "prd", "kind": "single", "appDir": "app" },
    { "name": "client-brics-care",   "agents": ["care-fe"],   "branch": "prd", "kind": "single", "appDir": "app" },
    { "name": "web-op",              "agents": ["op-fe"],     "branch": "prd", "kind": "single", "appDir": "app", "srcDir": "src" },
    { "name": "bznav-web", "kind": "monorepo", "branch": "dev",
      "$branchNote": "앱은 각자 prd-<앱>. packages/* 는 모든 앱이 공유하므로 통합 브랜치 dev 를 기준으로 둔다",
      "apps": {
        "refund-web": { "agent": "bznav-refund-fe", "branch": "prd-refund" },
        "care-web":   { "agent": "bznav-care-fe",   "branch": "prd-care" },
        "brand-web":  { "agent": "bznav-brand-fe",  "branch": "prd-brand" },
        "sena-web":   { "agent": "bznav-sena-fe",   "branch": "prd-sena" },
        "plus-web":   { "agent": "bznav-plus-fe",   "branch": "prd-plus" }
      },
      "packagesAgent": "bznav-packages-fe" },
    { "name": "zent-packages", "agents": ["packages-fe"], "branch": "main", "kind": "packages", "scope": "frontend" }
  ]
}
