{
  "$comment": "헤르메스가 담당하는 레포 목록. 경로는 reposRoot 기준이며 scripts/setup.sh 가 repos/<name> 링크를 만든다. branch = 문서·지식의 기준(운영 반영분). prBase = 작업 브랜치를 딸 기준이자 PR 대상(개발 브랜치). 둘은 다르다. bznav-web 은 앱마다 다르므로 apps 안에서 지정한다.",
  "reposRoot": "..",
  "repos": [
    { "name": "client-brics-refund", "agents": ["refund-fe"], "branch": "prd", "prBase": "dev", "kind": "single", "appDir": "app" },
    { "name": "client-brics-hub",    "agents": ["hub-fe"],    "branch": "prd", "prBase": "dev", "kind": "single", "appDir": "app" },
    { "name": "client-brics-care",   "agents": ["care-fe"],   "branch": "prd", "prBase": "dev", "kind": "single", "appDir": "app" },
    { "name": "web-op",              "agents": ["op-fe"],     "branch": "prd", "prBase": "dev", "kind": "single", "appDir": "app", "srcDir": "src" },
    { "name": "bznav-web", "kind": "monorepo", "branch": "dev",
      "$branchNote": "앱은 각자 prd-<앱>. packages/* 는 모든 앱이 공유하므로 통합 브랜치 dev 를 기준으로 둔다",
      "apps": {
        "refund-web": { "agent": "bznav-refund-fe", "branch": "prd-refund", "prBase": "dev-ecs" },
        "care-web":   { "agent": "bznav-care-fe",   "branch": "prd-care",   "prBase": "dev" },
        "brand-web":  { "agent": "bznav-brand-fe",  "branch": "prd-brand",  "prBase": "dev-ecs" },
        "sena-web":   { "agent": "bznav-sena-fe",   "branch": "prd-sena",   "prBase": "dev-ecs" },
        "plus-web":   { "agent": "bznav-plus-fe",   "branch": "prd-plus",   "prBase": "dev" }
      },
      "packagesAgent": "bznav-packages-fe",
      "$packagesNote": "packages/* 는 5개 앱이 공유하지만 PR base 는 앱 계열마다 다르다(dev = care·plus / dev-ecs = brand·refund·sena). 그래서 packagesPrBase 를 두지 않고 /branch 에서 bznav:packages@<앱> 으로 그 앱의 prBase 를 쓴다" },
    { "name": "zent-packages", "agents": ["packages-fe"], "branch": "main", "prBase": "main", "kind": "packages", "scope": "frontend" }
  ]
}
